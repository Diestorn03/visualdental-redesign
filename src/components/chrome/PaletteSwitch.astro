---
/*
  Proposal-only control (Base renders it when site.js `demo` is on): "Design proposal" tag + an Amber | Mono radiogroup, bottom left.
  It writes html[data-palette], ?palette= (replaceState) and localStorage 'vd-palette' (chrome.js). The selected state is styled from
  html[data-palette], which the inline script in Base sets before first paint, so a reload on Mono never flashes Amber.
*/
const options = [['amber', 'Amber'], ['mono', 'Mono']];
---
<div class="pal" data-theme="dark" data-pal>
  <span class="pal__tag" id="pal-tag">Design proposal</span>
  <div class="pal__seg" role="radiogroup" aria-labelledby="pal-tag">
    {options.map(([id, label]) => (
      <button type="button" role="radio" aria-checked={id === 'amber' ? 'true' : 'false'} tabindex={id === 'amber' ? 0 : -1} data-pal-opt={id}>
        <span class="pal__dot" data-palette={id} aria-hidden="true"></span><span class="pal__label">{label}</span>
      </button>
    ))}
  </div>
</div>

<script>
  import '../../scripts/chrome.js';
</script>

<style>
  .pal { position: fixed; z-index: var(--z-ribbon); left: max(12px, env(safe-area-inset-left)); bottom: max(12px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 12px; padding: 4px 4px 4px 14px; color: var(--fg); background: color-mix(in srgb, var(--bg) 96%, transparent); border: 1px solid var(--line); border-radius: var(--r-pill); transition: transform 0.6s var(--ease-out), opacity 0.4s var(--ease-out); }
  .pal__tag { font-family: var(--font-label); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .pal__seg { position: relative; display: grid; grid-template-columns: 1fr 1fr; border-radius: var(--r-pill); }
  /* sliding thumb: its place follows html[data-palette] */
  .pal__seg::before { content: ''; position: absolute; inset: 0 50% 0 0; border-radius: var(--r-pill); background: var(--fg); transition: transform var(--d-base) var(--ease-out); }
  :global(html[data-palette='mono']) .pal__seg::before { transform: translateX(100%); }
  .pal button { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 44px; min-width: 44px; padding: 0 1rem; border-radius: var(--r-pill); font-family: var(--font-label); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg); transition: color var(--d-base) var(--ease-out); }
  .pal__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 1px var(--line); }
  :global(html:not([data-palette='mono'])) .pal button[data-pal-opt='amber'], :global(html[data-palette='mono']) .pal button[data-pal-opt='mono'] { color: var(--bg); }
  :global(html:not([data-palette='mono'])) .pal button[data-pal-opt='amber'] .pal__dot, :global(html[data-palette='mono']) .pal button[data-pal-opt='mono'] .pal__dot { box-shadow: 0 0 0 1px color-mix(in srgb, var(--bg) 40%, transparent); }
  :global(html:not(.js)) .pal { display: none; } /* it needs JS to do anything */
  @media (max-width: 767px) { :global(html.has-bar) .pal { transform: translateY(calc(-1 * (var(--bar-h, 0px) + env(safe-area-inset-bottom)))); } } /* lifts above the bar; transform, not bottom: no layout shift */
  /* phones: only the switch, and only once the hero is behind (it would cover the first CTA); desktop: bottom centre, clear of the hero's bottom-left tags and the FAB */
  /* compact by default (two dots, bottom left) so it never covers content; the names open on hover/focus, always there for screen readers.
     It opens with a transition: tag and labels grow from width 0 (interpolate-size) while the paddings and the gap ease in, so the pill widens
     over --d-base instead of jumping from 98 to 346 px in one frame. Without interpolate-size (Firefox, Safari) the widths simply switch. */
  .pal { padding: 4px; gap: 0; interpolate-size: allow-keywords; transition: transform 0.6s var(--ease-out), opacity 0.4s var(--ease-out), padding var(--d-base) var(--ease-out), gap var(--d-base) var(--ease-out); }
  .pal button { padding: 0; gap: 0; transition: color var(--d-base) var(--ease-out), padding var(--d-base) var(--ease-out), gap var(--d-base) var(--ease-out); }
  .pal__tag, .pal__label { width: 0; overflow: hidden; white-space: nowrap; transition: width var(--d-base) var(--ease-out); } /* still in the accessibility tree */
  @media (hover: hover) and (min-width: 768px) {
    .pal:hover, .pal:focus-within { padding-left: 14px; gap: 12px; }
    .pal:hover .pal__tag, .pal:focus-within .pal__tag, .pal:hover .pal__label, .pal:focus-within .pal__label { width: auto; }
    .pal:hover button, .pal:focus-within button { padding: 0 1rem; gap: 0.5rem; }
  }
  /* hidden over the hero (it would cover the micro-tags on desktop and the first CTA on phones; it appears once the hero is behind) and over #contact
     (it sat on top of the channel and link lines there; the footer reserves room for it). The fade plays out before visibility flips. */
  :global(html.js:not(.past-hero)) .pal, :global(html.in-contact) .pal { opacity: 0; visibility: hidden; transition: transform 0.6s var(--ease-out), opacity 0.4s var(--ease-out), visibility 0s linear 0.4s; }
</style>
