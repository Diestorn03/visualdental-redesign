---
/*
  Intro loader, on every full load (F5 included). Base's head script sets html.is-loading before first paint, except with reduced motion or
  html.calm. While it is up: wheel/touch/scroll keys are swallowed (so Lenis never starts under it) and the hero's CSS entrance is paused.
  It leaves after fonts + the hero photo are ready, never before MIN nor after MAX; the class drops as the curtain starts to lift, so the hero
  plays while it is being revealed. Emits 'vd:loader-done' (hero.js waits for it). No JS: the class is never set, nothing shows.
*/
import { asset } from '../../lib/url.js';
---
<div class="ldr" aria-hidden="true">
  <div class="ldr__in">
    <img class="ldr__mark" src={asset('brand/logo-mark-light-192.webp')} srcset={`${asset('brand/logo-mark-light-192.webp')} 192w, ${asset('brand/logo-mark-light-372.webp')} 372w`} sizes="64px" width="192" height="305" alt="" decoding="async" fetchpriority="high" />
    <p class="ldr__word">Visual Dental</p>
    <p class="ldr__arts"><span class="ldr__rule"></span>Arts<span class="ldr__rule"></span></p>
    <div class="ldr__meter">
      <span class="ldr__track"><span class="ldr__bar" data-loader-bar></span></span>
      <span class="ldr__pct" data-loader-pct>00</span>
    </div>
    <p class="ldr__cap">Boutique Dental Laboratory</p>
  </div>
</div>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('.ldr');
  if (el && root.classList.contains('is-loading')) {
    const MIN = 1200, MAX = 2600, t0 = performance.now();
    const block = (e: Event) => { e.preventDefault(); e.stopImmediatePropagation(); };
    const KEYS = [' ', 'ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End'];
    const keys = (e: KeyboardEvent) => { if (KEYS.includes(e.key)) block(e); };
    addEventListener('wheel', block, { capture: true, passive: false });
    addEventListener('touchmove', block, { capture: true, passive: false });
    addEventListener('keydown', keys, { capture: true });

    const bar = el.querySelector<HTMLElement>('[data-loader-bar]')!;
    const pct = el.querySelector<HTMLElement>('[data-loader-pct]')!;
    const photo = document.querySelector<HTMLImageElement>('#top img');
    const tasks: Promise<unknown>[] = [document.fonts?.ready ?? Promise.resolve()];
    if (photo && !photo.complete) tasks.push(new Promise((r) => { photo.addEventListener('load', r, { once: true }); photo.addEventListener('error', r, { once: true }); }));
    let done = 0;
    tasks.forEach((p) => p.then(() => { done++; }));

    let ready = false, shown = 0, out = false;
    Promise.race([Promise.all(tasks), new Promise((r) => setTimeout(r, MAX))])
      .then(() => setTimeout(() => { ready = true; }, Math.max(0, MIN - (performance.now() - t0))));

    const finish = () => {
      out = true;
      el.classList.add('is-out');
      removeEventListener('wheel', block, { capture: true });
      removeEventListener('touchmove', block, { capture: true });
      removeEventListener('keydown', keys, { capture: true });
      root.classList.remove('is-loading'); // hero entrance resumes under the lifting curtain
      document.dispatchEvent(new CustomEvent('vd:loader-done', { bubbles: true }));
      setTimeout(() => el.remove(), 1100);
    };
    // the bar eases toward real progress (time-weighted so it never stalls at 0), and only reaches 100 once everything is ready
    const tick = () => {
      if (out) return;
      const time = Math.min(1, (performance.now() - t0) / MIN);
      const target = ready ? 1 : Math.min(0.92, 0.15 + 0.5 * time + 0.27 * (done / tasks.length));
      shown += (target - shown) * 0.14;
      bar.style.transform = `scaleX(${shown.toFixed(4)})`;
      pct.textContent = String(Math.round(shown * 100)).padStart(2, '0');
      if (ready && shown > 0.995) { bar.style.transform = 'scaleX(1)'; pct.textContent = '100'; setTimeout(finish, 160); return; }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .ldr { display: none; }
  :global(html.is-loading) .ldr, .ldr.is-out { display: grid; }
  .ldr { position: fixed; inset: 0; z-index: 2000; place-items: center; background: var(--ink); color: var(--paper);
    clip-path: inset(0 0 0 0); transition: clip-path 1s cubic-bezier(0.76, 0, 0.24, 1); }
  .ldr.is-out { clip-path: inset(0 0 100% 0); pointer-events: none; }
  /* failsafe: if the script never runs, the curtain still goes after 6 s */
  :global(html.is-loading) .ldr { animation: ldr-gone 0.01s linear 6s forwards; }
  @keyframes ldr-gone { to { visibility: hidden; } }

  .ldr__in { display: grid; justify-items: center; gap: 0.9rem; transition: opacity 0.5s var(--ease-out), transform 0.8s var(--ease-out); }
  .ldr.is-out .ldr__in { opacity: 0; transform: translateY(-28px); }
  .ldr__mark { width: 64px; height: auto; margin-bottom: 0.6rem; animation: ldr-mark 1.1s var(--ease-out) both; }
  .ldr__word, .ldr__arts { margin: 0; font-family: var(--font-label); font-weight: 500; text-transform: uppercase; line-height: 1; }
  .ldr__word { font-size: clamp(1.25rem, 3.2vw, 1.75rem); letter-spacing: 0.32em; margin-right: -0.32em; animation: ldr-track 1.4s var(--ease-out) 0.1s both; }
  .ldr__arts { display: flex; align-items: center; gap: 0.9rem; font-size: clamp(1.05rem, 2.6vw, 1.4rem); letter-spacing: 0.4em; margin-right: -0.4em; animation: ldr-fade 1s var(--ease-out) 0.35s both; }
  .ldr__rule { display: block; width: clamp(28px, 6vw, 48px); height: 1px; background: currentColor; opacity: 0.55; transform-origin: center; animation: ldr-rule 1s var(--ease-out) 0.45s both; }
  .ldr__meter { display: flex; align-items: center; gap: 0.9rem; margin-top: 1.6rem; }
  .ldr__track { position: relative; display: block; width: min(220px, 52vw); height: 1px; background: rgb(255 255 255 / 0.14); overflow: hidden; }
  .ldr__bar { position: absolute; inset: 0; background: var(--accent); transform: scaleX(0); transform-origin: left center; }
  .ldr__pct { min-width: 3ch; font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.14em; font-variant-numeric: tabular-nums; color: var(--accent); }
  .ldr__cap { margin: 0.2rem 0 0; font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--silver); animation: ldr-fade 1s var(--ease-out) 0.6s both; }

  @keyframes ldr-mark { from { opacity: 0; transform: translateY(10px) scale(0.94); } }
  @keyframes ldr-track { from { opacity: 0; letter-spacing: 0.6em; margin-right: -0.6em; } }
  @keyframes ldr-fade { from { opacity: 0; } }
  @keyframes ldr-rule { from { transform: scaleX(0); } }

  /* the hero's CSS entrance waits under the curtain, then plays as it lifts */
  :global(html.is-loading #top), :global(html.is-loading #top *) { animation-play-state: paused !important; }
</style>
