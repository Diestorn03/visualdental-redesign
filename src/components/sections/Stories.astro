---
/*
  #stories · light. Testimonial (line reveal) → 6 videos as facades (the studio film leads) → "Behind the scenes" strip of IG frames.
  Videos: without JS each frame is a link to YouTube. stories.js swaps it for a real <button> ("Play video: …") that replaces the
  thumbnail with a youtube-nocookie iframe on click (one video plays at a time).
  Strip: a native horizontal scroll row by default (no JS, reduced motion / "Reduce motion" switch). stories.js turns it into a slow
  CSS marquee (cloned set is inert). Pausing (off screen, hover, focus, Pause toggle) is done in stories.js with the Web Animations API.
*/
import Picture from '../ui/Picture.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { media } from '../../data/media.js';
import { social } from '../../data/site.js';

// Verbatim from docs/CONTENT.md §6. YouTube has no confirmed channel, videos are linked by id. // confirm with client
const videos = [
  { id: 'GuTcOzEswHo', title: 'Visual Dental Arts: Where Art Meets Innovation in Digital Dentistry', time: '4:45' },
  { id: 'wHwWyR-Vsfk', title: 'Collaboration with Aleksandra Polczynski & Visual Dental Arts', time: '3:21' },
  { id: 'tbf0E3Yq3Qs', title: 'A New Approach to Patient Consultation', time: '1:17' },
  { id: 'At9KcdW1_Cg', title: 'Streamlined Visits Through Chairside Collaboration', time: '0:44' },
  { id: 'cpuyUuM52s8', title: 'Breaking Free from Painful Veneer Procedures: A Real Patient Success Story', time: '6:56' },
  { id: '4_Bn42aDvnQ', title: 'A Story of Compassionate Family Dentistry with Dr. Miranda Cornejo', time: '6:03' },
];
// `sizes` = the real hole, so the browser does not fetch 960 px for a 392 px card. Container = min(1240px, 100vw - 2 gutters); 3 cols from 1024 (the lead takes 2),
// 2 cols from 640 (lead and last card take both), 1 col below; 1336px is where the container stops growing. Remeasure if the grid or --gutter change.
const sizes = {
  lead: '(min-width: 1336px) 816px, (min-width: 1024px) 61vw, 92vw',
  card: '(min-width: 1336px) 392px, (min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw',
  last: '(min-width: 1336px) 392px, (min-width: 1024px) 30vw, 92vw',
  ig: 'clamp(148px, 17vw, 232px)', // = --card-w
};
const iso = (t: string) => { const [m, s] = t.split(':'); return `PT${+m}M${+s}S`; };
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="stories" data-theme="light" class="section stories" aria-labelledby="stories-title">
  <div class="container">
    <header class="stories__head">
      <p class="eyebrow" data-reveal="fade">Stories</p>
      <h2 id="stories-title" class="display" data-split="lines">Every Smile Has a Story. <em>Here Are Ours.</em></h2>
    </header>

    <figure class="quote">
      <span class="quote__mark" aria-hidden="true">&ldquo;</span>
      <blockquote class="quote__body">
        <p class="quote__text" data-split="lines" data-delay=".1">They help me to do what I love to do best. Actually, the lab is what makes the doctor look good. <em>Behind every great dentist is a great lab.</em></p>
      </blockquote>
      <figcaption class="quote__by" data-reveal="up" data-delay=".35">
        <svg class="quote__rule" data-draw data-delay=".35" width="56" height="2" viewBox="0 0 56 2" fill="none" aria-hidden="true" focusable="false"><line x1="0" y1="1" x2="56" y2="1" stroke="currentColor" stroke-width="1.25" /></svg>
        <span class="quote__who">
          <span class="quote__name">Dr. Dean Boldin</span>
          <span class="quote__role">Accent Dental</span>
        </span>
      </figcaption>
    </figure>

    <ul class="vids" role="list">
      {videos.map((v, i) => (
        <li class:list={['vid', i === 0 && 'vid--lead']} data-reveal="up" data-delay={i === 0 ? 0 : (i % 3) * 0.08} data-video={v.id}>
          <div class="vid__frame">
            <Picture
              img={media.stories[v.id]}
              sizes={i === 0 ? sizes.lead : i === videos.length - 1 ? sizes.last : sizes.card}
            />
            <span class="vid__mark" aria-hidden="true"><span><Icon name="play" size={26} stroke={1.5} /></span></span>
            <time class="vid__dur num" datetime={iso(v.time)}>{v.time}</time>
            <a class="vid__hit vid__link" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer">
              <span class="sr-only">Watch on YouTube: {v.title} (opens in a new tab)</span>
            </a>
            <button class="vid__hit vid__btn" type="button" data-id={v.id} data-title={v.title} aria-label={`Play video: ${v.title}`}></button>
          </div>
          <div class="vid__cap">
            <span class="vid__n num" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="vid__title">{v.title}</h3>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <div class="strip" data-strip>
    <div class="container strip__head" data-reveal="up">
      <div>
        <h3 id="strip-title" class="strip__title">Behind the scenes</h3>
        <p class="strip__note muted">Frames from our reels. On Instagram: <span class="num">Cases · Process · Lab · Education · Art</span></p>
      </div>
      <Button class="strip__toggle" variant="ghost" size="sm" icon="pause" iconPosition="start" aria-pressed="false" hidden>Pause<span class="sr-only"> scrolling</span></Button>
    </div>

    <div class="strip__view" role="group" aria-labelledby="strip-title" data-reveal="fade">
      <div class="strip__track">
        <ul class="strip__set" role="list">
          {media.ig.map((f) => (
            <li class="strip__item">
              <a class="ig-card" href={f.href} target="_blank" rel="noopener noreferrer">
                <Picture img={f} sizes={sizes.ig} />
                <span class="ig-card__ig" aria-hidden="true"><Icon name="instagram" size={20} /></span>
                <span class="ig-card__go" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
                <span class="sr-only"> (Instagram reel, opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="container strip__foot" data-reveal="up">
      <Button variant="link" href={social.instagram} icon="arrow-up-right">Follow {social.instagramHandle}</Button>
    </div>
  </div>
</section>

<style>
  .stories { --gap: clamp(20px, 2.4vw, 32px); --card-w: clamp(148px, 17vw, 232px); --card-gap: clamp(12px, 1.6vw, 20px); }

  /* ---------- head + testimonial ---------- */
  .stories__head { max-width: 64rem; }
  .stories__head .eyebrow { margin-bottom: 1.4rem; }

  .quote { margin: clamp(48px, 7vw, 104px) 0 0; max-width: 60rem; }
  @media (min-width: 900px) { .quote { margin-left: auto; } }
  /* decorative opening mark: the quote itself stays plain text so SplitText and screen readers see only the words */
  .quote__mark { display: block; height: 0.46em; font-family: var(--font-display); font-size: clamp(5.5rem, 3.6rem + 8vw, 10rem); line-height: 0.9; color: var(--stroke); user-select: none; }
  .quote__body { margin: 0; }
  .quote__text { font-family: var(--font-display); font-size: var(--step-3); line-height: 1.12; letter-spacing: -0.012em; text-wrap: balance; }
  .quote__text em { font-style: italic; color: var(--stroke); }
  .quote__by { display: flex; align-items: center; gap: 18px; margin-top: clamp(28px, 3.5vw, 48px); }
  .quote__rule { flex: none; width: 56px; height: 2px; color: var(--stroke); }
  .quote__who { display: grid; gap: 2px; }
  .quote__name { font-family: var(--font-label); font-size: var(--step-0); font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; line-height: 1.3; }
  .quote__role { color: var(--muted); font-size: var(--step--1); letter-spacing: 0.04em; }

  /* ---------- videos ---------- */
  .vids { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(40px, 4.5vw, 64px) var(--gap); margin: clamp(80px, 10vw, 152px) 0 0; padding: 0; }
  .vid { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  /* Photo frames are square-cornered (they were --radius, 2px): an overflow clip with a radius puts a rounded-rect clip on every draw inside it (image, shade, play mark, badge,
     icons), and each combination is its own GPU shader program. Cold, in this section that was ~10 programs and 230-300 ms of D3D compiles, i.e. the 60-260 ms frame drops while
     scrolling (trace: GrShaderCache miss -> ProgramD3D::link -> D3DCompile in the raster flush). Without the radius: 4 programs, 70-100 ms. At 2px nobody can tell. */
  .vid__frame { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--fg); isolation: isolate; }
  .vid__frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; transition: transform 1.4s var(--ease-out); }
  .vid__frame::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(to top, color-mix(in srgb, var(--fg) 50%, transparent), transparent 45%); }
  .vid__frame :global(iframe) { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; border: 0; background: var(--fg); }
  .vid__frame.is-playing::after { display: none; }

  .vid__mark { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; pointer-events: none; }
  .vid__mark > span { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--bg) 85%, transparent); background: color-mix(in srgb, var(--fg) 38%, transparent); color: var(--bg); transition: transform var(--d-slow) var(--ease-out), background-color var(--d-base) var(--ease-out), color var(--d-base) var(--ease-out); }
  .vid__mark :global(svg) { transform: translateX(2px); }
  .vid--lead .vid__mark > span { width: clamp(64px, 7vw, 92px); height: clamp(64px, 7vw, 92px); }
  .vid__dur { position: absolute; left: 12px; bottom: 12px; z-index: 2; padding: 5px 9px 4px; border-radius: var(--radius); background: color-mix(in srgb, var(--fg) 72%, transparent); color: var(--bg); font-size: var(--step--1); line-height: 1; letter-spacing: 0.14em; }

  /* the interactive layer: a link without JS, a button once stories.js runs (class is-js) */
  .vid__hit { position: absolute; inset: 0; z-index: 3; display: block; width: 100%; height: 100%; cursor: pointer; }
  .vid__hit:focus-visible { outline: none; }
  .vid__frame:has(.vid__hit:focus-visible) { outline: 3px solid var(--stroke); outline-offset: 4px; }
  .stories:not(.is-js) .vid__btn { display: none; }
  .stories.is-js .vid__link { display: none; }
  @media (hover: hover) {
    .vid__frame:hover :global(img) { transform: scale(1.04); }
    .vid__frame:hover .vid__mark > span { transform: scale(1.08); background: var(--bg); color: var(--fg); }
  }
  .vid__frame:has(.vid__hit:focus-visible) .vid__mark > span { background: var(--bg); color: var(--fg); }

  .vid__cap { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; gap: 16px; }
  .vid__n { color: var(--stroke); font-size: var(--step--1); letter-spacing: 0.18em; }
  .vid__title { font-size: var(--step-1); line-height: 1.15; text-wrap: balance; }

  @media (min-width: 640px) {
    .vids { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vid--lead, .vid:last-child { grid-column: 1 / -1; }
    .vid:last-child:not(.vid--lead) .vid__frame { aspect-ratio: 21 / 9; }
  }
  @media (min-width: 1024px) {
    .vids { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .vid--lead { grid-column: 1 / span 2; grid-row: span 2; }
    .vid:last-child:not(.vid--lead) { grid-column: auto; }
    .vid:last-child:not(.vid--lead) .vid__frame { aspect-ratio: 16 / 9; }
    .vid--lead .vid__frame { flex: 1 1 auto; } /* the lead's frame absorbs the height of the two stacked captions on its right */
    .vid--lead .vid__title { font-size: var(--step-2); }
  }

  /* ---------- Behind the scenes strip ---------- */
  .strip { margin-top: clamp(88px, 11vw, 168px); }
  .strip__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px 32px; padding-top: clamp(32px, 4vw, 48px); border-top: 1px solid var(--line); margin-bottom: clamp(28px, 3.5vw, 48px); }
  .strip__title { font-size: var(--step-3); line-height: 1; letter-spacing: -0.012em; }
  .strip__note { margin-top: 0.9rem; font-size: var(--step--1); line-height: 1.5; }
  .strip__note .num { letter-spacing: 0.14em; text-transform: uppercase; }
  .strip :global(.btn.strip__toggle[hidden]) { display: none; }
  .strip :global(.btn.strip__toggle[aria-pressed='true']) { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  /* default = native scroll row (no JS / reduced). The first card lines up with the container edge. */
  .strip__view {
    --edge: max(var(--gutter), calc((100% - var(--container)) / 2));
    overflow-x: auto; overflow-y: hidden; padding: 8px var(--edge) 16px; scroll-padding-inline: var(--edge);
    scroll-snap-type: x proximity; scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .strip__track { position: relative; display: flex; width: max-content; }
  .strip__set { list-style: none; display: flex; align-items: flex-start; gap: var(--card-gap); margin: 0; padding: 0; }
  .strip__item { flex: none; width: var(--card-w); scroll-snap-align: start; }
  .strip__item:nth-child(even) { margin-top: clamp(20px, 3vw, 44px); } /* staggered rhythm */

  .ig-card { position: relative; display: block; aspect-ratio: 9 / 16; overflow: hidden; background: var(--fg); isolation: isolate; } /* square for the same reason as .vid__frame */
  .ig-card :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; transition: transform 1.4s var(--ease-out); }
  .ig-card::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to top, color-mix(in srgb, var(--fg) 55%, transparent), transparent 38%); }
  .ig-card__ig { position: absolute; left: 12px; bottom: 12px; z-index: 1; display: grid; color: var(--bg); }
  .ig-card__go { position: absolute; top: 10px; right: 10px; z-index: 1; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--bg); color: var(--fg); opacity: 0; transform: translate(-6px, 6px); transition: opacity var(--d-base) var(--ease-out), transform var(--d-slow) var(--ease-out); }
  .ig-card:focus-visible .ig-card__go { opacity: 1; transform: none; }
  @media (hover: hover) {
    .ig-card:hover :global(img) { transform: scale(1.05); }
    .ig-card:hover .ig-card__go { opacity: 1; transform: none; }
  }
  @media (hover: none) { .ig-card__go { opacity: 1; transform: none; } }

  .strip__foot { margin-top: clamp(24px, 3vw, 40px); }

  /* marquee mode (stories.js: motion allowed). Only transform animates; the second, inert set makes the loop seamless. */
  .strip.is-marquee .strip__view { position: relative; overflow: clip; padding-inline: 0; scroll-snap-type: none; }
  /* Edge fade = two flat-colour gradients over the strip (the section background is a flat var(--bg)), NOT mask-image: a mask makes an offscreen surface that is redrawn on every
     frame the loop moves and costs extra first-use shader programs (measured cold: 1-3 fewer programs, no per-frame mask pass). */
  .strip.is-marquee .strip__view::before, .strip.is-marquee .strip__view::after { content: ''; position: absolute; inset-block: 0; z-index: 2; width: 8%; pointer-events: none; }
  .strip.is-marquee .strip__view::before { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .strip.is-marquee .strip__view::after { right: 0; background: linear-gradient(270deg, var(--bg), transparent); }
  .strip.is-marquee .strip__set { padding-right: var(--card-gap); }
  .strip.is-marquee .strip__track { margin-left: 8px; animation: strip-slide 90s linear infinite; will-change: transform; } /* 8px: room for the focus ring of the first card */
  .strip.is-marquee .strip__view:has(:focus-visible)::before, .strip.is-marquee .strip__view:has(:focus-visible)::after { display: none; } /* keyboard focus: the ring needs the edge. Not :focus-within: a mouse click leaves the link focused */
  /* pausing (Pause button, off screen, hover, focus) is done by stories.js through the Web Animations API: a CSS animation-play-state was ignored at random */
  @keyframes strip-slide { to { transform: translate3d(-50%, 0, 0); } }
</style>

<script>
  import '../../scripts/stories.js';
</script>
