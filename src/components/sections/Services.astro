---
/*
  #services (light): catalogue index 01–06 + the "Analog Meets Digital." close.
  Wide + fine pointer + motion allowed (env.desktop): the photo of the active row sits in a preview ANCHORED (position: sticky) in the
  empty lane at the right of the list; it never chases the pointer. The active row follows hover, keyboard focus or, when the pointer is
  not moving, the row crossing the middle of the viewport (src/scripts/services.js). Everywhere else (touch, narrow, reduced, no JS) each
  row shows its photo inline from CSS alone, in the same grid cell, so there is no layout shift between modes.
*/
import Picture from '../ui/Picture.astro';
import Button from '../ui/Button.astro';
import { media } from '../../data/media.js';
import { asset } from '../../lib/url.js';

// CONTENT §3, verbatim. `key` = media.services.<key>
const items = [
  { key: 'dsd', title: 'Digital Smile Design (DSD) & Esthetic Planning', text: 'Creating digital previews, 3D smile simulations, and treatment mock-ups for dentists and patients.' },
  { key: 'printing', title: '3D Printing & Milling Solutions', text: 'Crown, bridge, implant, and temporary restorations produced using in-house multi-material 3D printers and mills.' },
  { key: 'shade', title: 'Shade-Taking & Mobile Patient Consultations', text: 'On-site or virtual shade matching, esthetic photography, and functional analysis.' },
  { key: 'implant', title: 'Implant Restoration Planning & Custom Abutments', text: 'Digital implant workflows, guided surgery collaboration, and CAD/CAM abutment design.' },
  { key: 'ceramic', title: 'High-End Ceramic Artistry', text: 'Hand-layered ceramics, custom staining, analog mastery, and natural-looking restorations.' },
  { key: 'education', title: 'Continuing Education & In-House Lectures', text: 'Hands-on workshops, lunch-and-learns, case review sessions, and paid lecture bookings.', href: '#education' },
];
const materials = ['layered zirconia', 'lithium disilicate', 'hybrid ceramics'];
const files = ['STL', 'DICOM', 'Smilecloud®'];
const loop = media.loops?.ceramic; // plays in the panel for the ceramic row
const two = (n) => String(n + 1).padStart(2, '0');
---
<section id="services" data-theme="light" class="section svc" aria-labelledby="services-title">
  <div class="container">
    <header class="svc__head">
      <p class="eyebrow" data-reveal="fade">Services</p>
      <h2 id="services-title" data-split="lines">Exceptional Services Crafted for Modern Dentistry</h2>
    </header>

    <div class="svc__index">
      <ol class="svc__list" role="list">
        {items.map((it, i) => (
          <li class:list={['svc__row', it.href && 'svc__row--link']} data-reveal="up" data-delay={((i % 3) * 0.08).toFixed(2)}>
            <span class="svc__num num" aria-hidden="true">{two(i)}</span>
            <div class="svc__text">
              <h3 class="svc__title">{it.title}</h3>
              <p class="svc__desc">{it.text}</p>
              {it.href && <Button variant="link" size="sm" icon="arrow-right" href={it.href} class="svc__more">Explore education</Button>}
            </div>
            <figure class="svc__thumb">
              <Picture img={media.services[it.key]} sizes="(min-width: 768px) 440px, calc(100vw - 80px)" />
            </figure>
          </li>
        ))}
      </ol>

      {/* decorative, aria-hidden: the lane is as tall as the list; the preview sticks inside it (CSS) and JS only picks the photo */}
      <div class="svc__lane" aria-hidden="true">
        <figure class="svc__panel">
          <div class="svc__frame">
            {items.map((it) => (
              <div class="svc__slide">
                {it.key === 'ceramic' && loop ? (
                  <video class="svc__video" muted loop playsinline preload="none" disablepictureinpicture tabindex="-1" width={loop.w} height={loop.h} data-poster={asset(`${loop.poster.base}-960.jpg`)}>
                    <source src={asset(`${loop.base}.webm`)} type="video/webm" />
                    <source src={asset(`${loop.base}.mp4`)} type="video/mp4" />
                  </video>
                ) : (
                  <Picture img={media.services[it.key]} sizes="(min-width: 1400px) 400px, 30vw" alt="" />
                )}
              </div>
            ))}
          </div>
          {/* live caption + six invisible copies stacked in the same grid cell: the caption box is always as tall as the longest title at this width, so the panel never changes height when the active row changes (it would jump while held at the end of the lane) */}
          <figcaption class="svc__cap">
            <span class="svc__capi"><span class="svc__cap-n num" data-cap-n>01</span><span data-cap-t>{items[0].title}</span></span>
            {items.map((it, i) => <span class="svc__capi svc__capi--ghost" aria-hidden="true" data-n={two(i)} data-t={it.title}></span>)}
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="svc__close">
      <svg class="svc__rule" data-draw viewBox="0 0 1200 56" fill="none" stroke="var(--stroke)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M0 28C60 28 90 6 150 6S240 50 300 50S390 8 450 8S520 28 560 28" />
        <path d="M560 28L620 8L680 48L740 8L800 48L860 8L920 28H1190" />
        <path d="M620 8H860M680 48H800" />
        <circle cx="1195" cy="28" r="3" />
      </svg>
      <div class="svc__close-grid">
        <h3 class="svc__close-title" data-split="lines">Analog <em>Meets</em> Digital.</h3>
        <div class="svc__close-body">
          <p class="lead" data-reveal="up">Where timeless craftsmanship merges seamlessly with modern digital innovation.</p>
          <div class="svc__chips" data-reveal="up" data-delay=".1">
            <div>
              <p id="svc-materials" class="svc__label">Materials</p>
              <ul class="svc__chiplist" role="list" aria-labelledby="svc-materials">
                {materials.map((m) => <li class="svc__chip">{m}</li>)}
              </ul>
            </div>
            <div>
              <p id="svc-files" class="svc__label">Files</p>
              <ul class="svc__chiplist svc__chiplist--files" role="list" aria-labelledby="svc-files">
                {files.map((f) => <li class="svc__chip">{f}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .svc { --lane: clamp(200px, 32%, 440px); }

  .svc__head { margin-bottom: clamp(40px, 6vw, 88px); }
  .svc__head h2 { max-width: 54rem; }

  /* ---------- index ---------- */
  .svc__index { position: relative; }
  .svc__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .svc__row {
    position: relative; display: grid; align-items: baseline;
    grid-template-columns: 2.75rem minmax(0, 1fr); column-gap: clamp(12px, 3vw, 40px);
    padding-block: clamp(28px, 3.6vw, 52px); border-bottom: 1px solid var(--line); border-radius: var(--radius);
  }
  /* amber hairline that draws across the active row (transform only) */
  .svc__row::after { content: ''; position: absolute; inset: auto 0 -1px 0; height: 1px; background: var(--stroke); transform: scaleX(0); transform-origin: left; transition: transform var(--d-base) var(--ease-out); pointer-events: none; }
  .svc__num { font-size: var(--step-0); color: var(--muted); transition: color var(--d-base) var(--ease-out), opacity var(--d-base) var(--ease-out); }
  .svc__title { font-size: clamp(1.65rem, 1.1rem + 2.6vw, 2.1rem); line-height: 1.06; transition: opacity var(--d-base) var(--ease-out), color var(--d-base) var(--ease-out); }
  .svc__desc { margin-top: 0.85rem; max-width: 46ch; color: var(--muted); }
  .svc__text :global(.svc__more) { margin-top: 0.75rem; }
  .svc__row--link { cursor: pointer; }
  .svc__row--link :global(.svc__more)::after { content: ''; position: absolute; inset: 0; } /* whole row is the link */
  :global(html.is-desktop-fx) .svc__row--link { cursor: auto; }
  :global(html.is-desktop-fx) .svc__row--link :global(.svc__more)::after { right: var(--lane); } /* ...except the lane at the right, where the sticky photo can lie over this row: clicking the photo must not navigate */

  /* inline photo: touch, narrow, reduced, no JS */
  .svc__thumb { position: relative; grid-column: 2; margin: 1.5rem 0 0; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); }
  .svc__thumb :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }

  @media (min-width: 768px) {
    .svc__row { grid-template-columns: 3.25rem minmax(0, 1fr) var(--lane); align-items: baseline; column-gap: clamp(32px, 3vw, 40px); } /* ≥ 32 px: the arrow that points at the preview lives in the gap before the lane */
    .svc__num { font-size: var(--step-1); }
    .svc__title { font-size: var(--step-3); }
    /* wide: the photo is a strip in the lane cell (same lane the sticky preview uses, so no shift between modes) */
    .svc__thumb { grid-column: 3; grid-row: 1; align-self: stretch; margin: 0; aspect-ratio: auto; }
  }
  /* the sticky preview replaces the strips exactly when the engine's desktop gate is on (same query, so no flash of strips on load) */
  @media (min-width: 768px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.calm)) .svc__thumb { display: none; }
  }

  /* ---------- active row (only with the preview: html.is-desktop-fx). Once initialised there is always one. ---------- */
  :global(html.is-desktop-fx) .svc__list.is-active .svc__row:not(.is-active) :is(.svc__num, .svc__title) { opacity: 0.55; }
  :global(html.is-desktop-fx) .svc__row.is-active::after { transform: scaleX(1); }
  :global(html.is-desktop-fx) .svc__row.is-active :is(.svc__num, .svc__title) { color: var(--stroke); }
  /* arrow that points at the preview (the lane), drawn in the gap between the text column and the lane */
  :global(html.is-desktop-fx) .svc__row::before { content: '\2192'; position: absolute; right: calc(var(--lane) + 6px); top: calc(clamp(28px, 3.6vw, 52px) + var(--step-3) * 0.53 - 0.5em); font-family: var(--font-label); font-size: var(--step-1); line-height: 1; color: var(--stroke); opacity: 0; transform: translateX(-10px); transition: opacity var(--d-base) var(--ease-out), transform var(--d-slow) var(--ease-out); pointer-events: none; }
  :global(html.is-desktop-fx) .svc__row.is-active::before { opacity: 1; transform: none; }

  /* ---------- sticky preview: lives INSIDE .svc__lane (absolute, as tall as the list), so it sticks while the list scrolls and leaves with it ---------- */
  .svc__lane { position: absolute; top: 0; bottom: 0; right: 0; width: var(--lane); pointer-events: none; }
  .svc__panel { display: none; margin: 0 0 24px; background: var(--bg); } /* opaque: row focus rings and rules never show through the photo or its caption */
  :global(html.is-desktop-fx) .svc__panel { display: block; position: sticky; top: max(calc(var(--header-h) + 24px), calc(50vh - 12rem)); } /* centred on the reading line (the row JS marks as current crosses the middle of the viewport), never under the header */
  .svc__frame { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface); }
  /* slides stay display:none until the list is near the viewport (JS adds .is-warm to .svc__panel) so the six photos are not fetched with the page; JS then toggles visibility / clip-path */
  .svc__slide { position: absolute; inset: 0; display: none; visibility: hidden; overflow: hidden; clip-path: inset(100% 0% 0% 0%); }
  .svc__panel.is-warm .svc__slide { display: block; }
  .svc__slide :global(img), .svc__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .svc__cap { display: grid; margin-top: 14px; font-family: var(--font-label); font-size: var(--step--1); letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.4; color: var(--fg); }
  .svc__capi { grid-area: 1 / 1; display: flex; align-items: baseline; gap: 0.6rem; }
  .svc__cap-n { flex: none; color: var(--stroke); }
  .svc__cap-n::after { content: ' \2014'; color: var(--muted); }
  /* ghosts: same box as the live caption (number + em dash, gap, title) built from attributes so the text is not duplicated in the DOM; only their size counts */
  .svc__capi--ghost { visibility: hidden; pointer-events: none; }
  .svc__capi--ghost::before { content: attr(data-n) ' \2014'; flex: none; }
  .svc__capi--ghost::after { content: attr(data-t); }

  /* ---------- close: Analog Meets Digital ---------- */
  .svc__close { margin-top: clamp(72px, 9vw, 144px); }
  .svc__rule { width: 100%; height: auto; margin-bottom: clamp(32px, 5vw, 72px); }
  .svc__rule { overflow: visible; }
  .svc__rule :is(path, circle) { vector-effect: non-scaling-stroke; }
  .svc__close-grid { display: grid; gap: 32px clamp(32px, 6vw, 96px); }
  .svc__close-title { font-size: var(--step-4); line-height: 0.98; }
  .svc__close-title em { font-style: italic; color: var(--stroke); }
  .svc__chips { display: grid; gap: 1.75rem; margin-top: 2.25rem; }
  .svc__label { margin-bottom: 0.8rem; font-family: var(--font-label); font-size: var(--step--1); font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  .svc__chiplist { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .svc__chip { display: inline-flex; align-items: center; min-height: 40px; padding: 0 1.15rem; border: 1px solid var(--line); border-radius: var(--r-pill); font-family: var(--font-label); font-size: var(--step--1); font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.2; }
  /* materials are round (analog), files are square-cornered (digital) */
  .svc__chiplist--files .svc__chip { border-radius: var(--radius); border-color: color-mix(in srgb, var(--stroke) 60%, transparent); }
  @media (min-width: 900px) {
    .svc__close-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }
</style>

<script>
  import '../../scripts/services.js';
</script>
