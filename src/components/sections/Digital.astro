---
/*
  #digital (dark): "Our standards are high and digital." A CAD-style planning window (generic implant-planning UI: no third-party logo or name)
  that stays put (CSS position: sticky, no ScrollTrigger pin) while the six steps scroll past it on the right. The scroll position drives a
  three.js scene (src/scripts/digital/scene.js) and three CBCT slices (cbct.js); src/scripts/digital.js wires it all.
  Copy: docs/DIGITAL.md (steps verbatim from the client's reel; the support lines are fragments of copy already on the site, see CONTENT.md).
  Layout: >= 1000 px and a fine pointer = window sticky on the left, steps scrolling on the right; anything else = window sticky on top (55svh), steps below.
  Modes (data-mode on the section, decided once by digital.js, so the layout never changes after load):
    live    sticky window + steps, WebGL scene. Narrow / touch: the window sticks on top (55svh), steps scroll under it.
    static  reduced motion, calm switch, low-power guess, no JS: the window shows the poster (public/media/digital-poster-<w>.{avif,webp,jpg})
            and the steps become a plain grid. If the poster is not there yet the viewport keeps its neutral CAD gradient.
  The default markup is the finished state (step 6/6), so no-JS and static need nothing from scripts.
*/
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import Picture from '../ui/Picture.astro';

// CONTENT/DIGITAL verbatim. `line` = fragment of existing site copy (FAQ 2 · Services 01 · Services 04 split in three · reel micro-note).
const steps = [
  { title: 'Accurate scans', line: 'We work seamlessly with all major intraoral scanners and accept STL, DICOM, and Smilecloud® shared cases.' },
  { title: 'Prosthetically driven planning', line: 'Digital previews, 3D smile simulations, and treatment mock-ups for dentists and patients.' },
  { title: 'Implants exactly where we planned them', line: 'Digital implant workflows.' },
  { title: 'A surgical guide that fits', line: 'Guided surgery collaboration.' },
  { title: 'Components that fit the first time', line: 'CAD/CAM abutment design.' },
  { title: 'A provisional ready when the patient is', line: 'Teeth printed during the surgery.' },
];
const N = steps.length;
const last = N - 1;

// Toolbar: generic CAD tools, one per step (the active one lights up in --accent). data-on = steps where it is active.
const tools = [
  { name: 'Scan', on: [0], d: '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M3 12h18"/>' },
  { name: 'Measure', on: [1], d: '<path d="M4 17 17 4l3 3L7 20z"/><path d="m7.5 13.5 2 2M10.5 10.5l1.5 1.5M13.5 7.5l2 2"/>' },
  { name: 'Section', on: [2], d: '<path d="M3 14.5 12 19l9-4.5-9-4.5z"/><path d="M12 3v6M9 6l3-3 3 3"/>' },
  { name: 'Implant', on: [2], d: '<path d="M8 3h8v3H8z"/><path d="M9 6v9l3 5 3-5V6"/><path d="M9 9h6M9 12h6M9.5 15h5"/>' },
  { name: 'Guide', on: [3], d: '<path d="M3 16c0-6.5 4-11 9-11s9 4.5 9 11"/><path d="M3 16h18"/><circle cx="12" cy="10.5" r="1.8"/>' },
  { name: 'Layers', on: [4], d: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/>' },
  { name: 'Rotate', on: [5], d: '<path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 4v4h-4"/>' },
];

// CBCT slices: the canvas size is the drawing buffer (cbct.js reads it); the CSS box keeps the same 8:5 ratio.
const views = [['axial', 'Axial'], ['sagittal', 'Sagittal'], ['coronal', 'Coronal']];

// Callouts: HTML labels pinned to 3D points (scene.project(anchor) → x/y in canvas px). from = first step where they show.
const callouts = [
  { anchor: 'axisTop', text: 'Prosthetic axis', from: 1, len: 30, side: 'l' }, // axisTop and angle project to almost the same screen point: they open in opposite directions
  { anchor: 'implantBody', text: 'Ø 4.0 × 10 mm', from: 2, len: 26, below: true, side: 'l' },
  { anchor: 'angle', text: 'Angle 12°', from: 2, len: 26 },
];

// Poster for static mode: every width that exists in all three formats (written by the capture step, see README "Digital"). Optional.
let poster = null;
try {
  const files = new Set(readdirSync(join(process.cwd(), 'public/media')));
  const widths = [...files].map((f) => /^digital-poster-(\d+)\.avif$/.exec(f)?.[1]).filter(Boolean).map(Number)
    .filter((w) => ['webp', 'jpg'].every((e) => files.has(`digital-poster-${w}.${e}`))).sort((a, b) => a - b);
  if (widths.length) {
    const w = widths.at(-1);
    poster = { base: 'media/digital-poster', widths, w, h: Math.round((w * 10) / 16), alt: '', position: '50% 50%' };
  }
} catch {
  /* no public/media at build time: no poster */
}
---
<section id="digital" data-theme="dark" class="section dg" data-poster={poster ? '1' : '0'} aria-labelledby="digital-title">
  <script is:inline>
    // Reduced motion / calm switch are known before first paint: pick the static layout now so nothing moves afterwards.
    (function () { var s = document.currentScript.parentElement, d = document.documentElement; if (matchMedia('(prefers-reduced-motion: reduce)').matches || d.classList.contains('calm')) s.dataset.mode = 'static'; })();
  </script>
  <div class="container">
    <header class="section__head dg__head">
      <p class="eyebrow" data-reveal="fade">Digital workflow</p>
      <h2 id="digital-title" class="display" data-split="lines">Our standards are high and <em>digital</em>.</h2>
      <p class="lead" data-reveal="up" data-delay=".1">Digital implant workflows, guided surgery collaboration, and CAD/CAM abutment design.</p>
    </header>

    <div class="dg__body">
      <div class="dg__stage">
        <figure class="dg__fig">
          <div class="dg__win" aria-hidden="true">
            <div class="dg__bar">
              <span class="dg__dots"><i></i><i></i><i></i></span>
              <span class="dg__title">Implant planning · illustrative case</span>
              <span class="dg__tag">Illustrative 3D visualization</span>
            </div>

            <div class="dg__main">
              <ul class="dg__tools" role="presentation">
                {tools.map((t) => (
                  <li class:list={['dg__tool', t.on.includes(last) && 'is-on']} data-on={t.on.join(' ')}>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={t.d} />
                  </li>
                ))}
              </ul>

              <div class="dg__vp">
                {poster && <Picture img={poster} class="dg__poster" alt="" sizes="(min-width: 1000px) 940px, 100vw" />}
                <canvas class="dg__canvas" aria-hidden="true"></canvas>
                <span class="dg__vp-label">Implant planning</span>
                <div class="dg__calls">
                  {callouts.map((c) => <span class="dg__call" data-anchor={c.anchor} data-from={c.from} data-len={c.len} data-below={c.below ? '' : undefined} data-side={c.side} style={`--len:${c.len}px`}><span class="dg__call-t">{c.text}</span></span>)}
                </div>
                <svg class="dg__gizmo" viewBox="0 0 56 56" width="56" height="56" fill="none" stroke-width="1.5" stroke-linecap="round" focusable="false">
                  <path d="M28 36 47 44" stroke="var(--dg-x)" /><path d="M28 36 9 44" stroke="var(--dg-y)" /><path d="M28 36V9" stroke="var(--dg-z)" />
                  <circle cx="28" cy="36" r="2" fill="var(--muted)" stroke="none" />
                  <g class="dg__gizmo-t" stroke="none"><text x="48" y="52" fill="var(--dg-x)">X</text><text x="3" y="52" fill="var(--dg-y)">Y</text><text x="25" y="7" fill="var(--dg-z)">Z</text></g>
                </svg>
                <span class="dg__hint">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 4v4h-4"/></svg>
                  Drag to rotate
                </span>
              </div>
            </div>

            <div class="dg__cbct">
              {views.map(([v, label]) => (
                <div class="dg__pane" data-view={v}>
                  <canvas width="384" height="240"></canvas>
                  <span class="dg__pane-l">{label}</span>
                </div>
              ))}
            </div>

            <div class="dg__wiz">
              <span class="dg__wiz-n">Step <b data-n>{N}</b>/{N}</span>
              <span class="dg__wiz-t" data-t>{steps[last].title}</span>
              <span class="dg__prog"><i data-fill></i>{[1, 2, 3, 4, 5].map((k) => <b style={`left:${((k * 100) / N).toFixed(3)}%`}></b>)}</span>
            </div>
          </div>
          <figcaption class="sr-only">Illustrative 3D visualization of a digital implant workflow: scan, prosthetic planning, implant placement, surgical guide, abutment and provisional crown.</figcaption>
        </figure>
      </div>

      <ol class="dg__steps" role="list">
        {steps.map((s, i) => (
          <li class:list={['dg__step', i === last && 'is-on']} data-i={i}>
            <span class="dg__no num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="dg__name"><a class="dg__link" href={`#digital-step-${i + 1}`} id={`digital-step-${i + 1}`}>{s.title}</a></h3>
            <p class="dg__line">{s.line}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .dg {
    --dg-cad-top: #323b47; /* CAD viewport: cool blue-grey, the one colour outside the palette (it is what makes it read as a 3D app) */
    --dg-cad-bot: #12161c;
    --dg-win: color-mix(in srgb, var(--fg) 5%, var(--bg));
    --dg-edge: color-mix(in srgb, var(--fg) 16%, transparent);
    --dg-x: #e08a80; --dg-y: #9bc78b; --dg-z: #7fa8de; /* gizmo triad, muted */
    --dg-top: calc(var(--header-h) + 12px);
    /* Window height: 680 px up to the 1240 px container, then it grows with the container so the window keeps the same proportions on big screens
       (container up to 1600 px from ~1700 px wide; the 3D view stays ~1.6:1). Never taller than the screen minus the header and 70 px at the bottom, which is where the
       fixed palette switch (bottom-left) would otherwise sit on top of "Step N/6" on short screens (1280x720, 1024x768). */
    --dg-gap: clamp(32px, 4vw, 64px);
    --dg-cw: min(100vw - 2 * var(--gutter), clamp(1240px, 100vw - 2 * var(--gutter) - 200px, 1600px));
    --dg-stage-h: min(calc(100svh - var(--header-h) - 82px), max(680px, calc(55px + 0.5236 * (var(--dg-cw) - var(--dg-gap)))));
    --dg-step-h: clamp(17rem, 40svh, 25rem);
    background: var(--bg);
  }
  .dg__head { margin-bottom: clamp(32px, 5vw, 64px); }
  .dg__head .display { max-width: 16ch; }
  .dg__head .display em { color: var(--stroke); }

  /* ---------- layout: wide + fine pointer = stage left (sticky) and steps right; everything else = stage on top (sticky), steps below ---------- */
  .dg__body { display: grid; max-width: 46rem; margin-inline: auto; }
  .dg__stage { position: sticky; top: 0; z-index: 2; height: 55svh; margin-inline: calc(var(--gutter) * -1); padding: 8px var(--gutter); background: var(--bg); transition: transform 0.6s var(--ease-out); }
  /* stacked layout: the header comes back on a scroll up and would cover the window's title bar. digital.js sets .is-stuck while the window is stuck at the top;
     then it rides down by the header's height, in step with the header (same duration and easing). Transform only. */
  html:has([data-header]:not(.is-hidden)) .dg.is-stuck .dg__stage { transform: translateY(var(--header-h)); }
  .dg__fig { height: 100%; margin: 0; }
  .dg__steps { list-style: none; padding-bottom: 20svh; }
  /* big screens: the window and the steps break out of the 1240 px column (the heading stays on the page's grid), up to 1600 px */
  @media (min-width: 1500px) and (pointer: fine) { .dg__body { width: var(--dg-cw); margin-inline: calc((100% - var(--dg-cw)) / 2); } }
  @media (min-width: 1000px) and (pointer: fine) {
    .dg { background: radial-gradient(70% 50% at 28% 55%, color-mix(in srgb, var(--stroke) 7%, transparent), transparent 70%), var(--bg); } /* a soft studio-lamp glow behind the window (the sticky bar of the stacked layout needs a flat colour) */
    .dg__body { max-width: none; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); column-gap: var(--dg-gap); align-items: start; }
    .dg__stage { top: var(--dg-top); height: var(--dg-stage-h); margin: 0; padding: 0; background: none; z-index: auto; }
    /* step 1 is centred on the window's middle when the window locks; the tail keeps the window stuck while the last zone plays out */
    .dg__steps { padding-block: calc((var(--dg-stage-h) - var(--dg-step-h)) / 2) calc(var(--dg-stage-h) / 2); }
  }

  /* ---------- window ---------- */
  .dg__win {
    /* No box-shadow, no radius, no overflow:hidden here: with a live WebGL canvas inside they cost frames (A/B, p95 40-70 ms -> 20 ms). contain: paint clips. */
    display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto; height: 100%; contain: layout paint;
    border: 1px solid var(--dg-edge); background: var(--dg-win);
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.7rem; line-height: 1;
  }
  .dg__bar { display: flex; align-items: center; gap: 14px; height: 38px; padding: 0 14px; border-bottom: 1px solid var(--dg-edge); color: var(--muted); }
  .dg__dots { display: flex; gap: 6px; flex: none; }
  .dg__dots i { width: 9px; height: 9px; border: 1px solid var(--dg-edge); border-radius: 50%; }
  .dg__title { min-width: 0; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .dg__tag { flex: none; padding: 4px 8px; border: 1px solid color-mix(in srgb, var(--stroke) 45%, transparent); border-radius: var(--r-pill); color: var(--stroke); font-size: 0.62rem; letter-spacing: 0.14em; }

  .dg__main { display: grid; grid-template-columns: auto minmax(0, 1fr); min-height: 0; }
  .dg__tools { list-style: none; display: flex; flex-direction: column; gap: 2px; margin: 0; padding: 8px 6px; border-right: 1px solid var(--dg-edge); }
  .dg__tool { display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--radius); color: var(--muted); transition: color 0.4s, background-color 0.4s; }
  .dg__tool.is-on { color: var(--stroke); background: color-mix(in srgb, var(--stroke) 14%, transparent); box-shadow: inset 2px 0 0 var(--stroke); }

  /* viewport: CAD gradient + faint dotted grid + vignette; poster and canvas fill it */
  .dg__vp { position: relative; min-height: 0; overflow: hidden; background: radial-gradient(120% 95% at 50% 36%, var(--dg-cad-top), var(--dg-cad-bot)); }
  .dg__vp::before { content: ''; position: absolute; inset: 0; background: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.2px) 0 0 / 28px 28px; mask-image: radial-gradient(75% 70% at 50% 55%, #000, transparent); pointer-events: none; }
  .dg__vp::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 45%, transparent 55%, rgb(0 0 0 / 0.5)); pointer-events: none; }
  /* Live: the canvas brings its own backdrop (gradient + vignette baked into the scene), so the CSS one is a flat colour. Three CSS gradients (background, dotted
     grid under a mask, vignette) are three GPU shader programs that compile when the window is first painted: on a cold shader cache that was a 100-200 ms frame as the
     window scrolled into view (A/B, cold profile: flat colour = no frame; hiding canvas, CBCT or steps = no change). Static keeps the gradients (the poster sits on them). */
  .dg[data-mode='live'] .dg__vp { background: #1f262f; }
  .dg[data-mode='live'] .dg__vp::before, .dg[data-mode='live'] .dg__vp::after { display: none; }
  .dg__poster, .dg__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dg__poster { object-fit: cover; transition: opacity 0.8s var(--ease-out); }
  .dg__canvas { opacity: 0; transition: opacity 0.8s var(--ease-out); touch-action: pan-y; } /* touch: the page keeps scrolling, no gesture is captured */
  .dg.is-live .dg__canvas { opacity: 1; }
  .dg.is-live .dg__poster { opacity: 0; }
  .dg[data-mode='static']:not(.is-still) .dg__canvas { display: none; } /* static: poster instead; .is-still = no poster yet, one rendered frame stands in */
  .dg.is-still .dg__canvas { opacity: 1; }
  .dg__vp.is-drag { cursor: grab; }
  .dg__vp.is-drag:active { cursor: grabbing; }

  .dg__vp-label { position: absolute; z-index: 1; left: 14px; top: 12px; color: var(--muted); font-size: 0.64rem; pointer-events: none; }
  .dg__gizmo { position: absolute; z-index: 1; left: 10px; bottom: 8px; width: 48px; height: 48px; pointer-events: none; }
  .dg__gizmo-t { font-family: var(--font-label); font-size: 8px; letter-spacing: 0; }
  .dg__hint { position: absolute; z-index: 1; right: 14px; bottom: 12px; display: flex; align-items: center; gap: 8px; color: var(--fg); font-size: 0.64rem; opacity: 0; transition: opacity 0.5s; pointer-events: none; }
  .dg__hint.is-on, .dg__hint.is-intro { opacity: 0.85; }
  @media (pointer: coarse) { .dg__hint { display: none; } }

  /* callouts: a dot on the 3D point, a short diagonal leader and the label on a dark plate (readable over threads, bone and mesh alike; no backdrop-filter).
     The label sits on one of four corners of the leader's end (above/below x right/left): transform only, so a change of side is never a layout shift. */
  .dg__calls { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .dg__call { --len: 22px; --o: calc(var(--len) * 0.7071); position: absolute; left: 0; top: 0; width: 0; height: 0; opacity: 0; transition: opacity 0.4s; will-change: transform; }
  .dg__call.is-on { opacity: 1; }
  .dg__call::before { content: ''; position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 50%; background: var(--stroke); box-shadow: 0 0 0 3px color-mix(in srgb, var(--stroke) 28%, transparent); }
  .dg__call::after { content: ''; position: absolute; left: 0; top: 0; width: var(--len); height: 1px; background: var(--stroke); transform-origin: 0 0; transform: rotate(-45deg); }
  .dg__call-t { position: absolute; left: 0; top: 0; padding: 3px 7px; border: 1px solid color-mix(in srgb, var(--stroke) 38%, transparent); background: rgb(10 12 16 / 0.74); white-space: nowrap; color: var(--fg); font-family: var(--font-label); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: none; transform: translate(var(--o), calc(-100% - var(--o))); }
  .dg__call.is-flip::after { transform: scaleX(-1) rotate(-45deg); }
  .dg__call.is-flip .dg__call-t { transform: translate(calc(-100% - var(--o)), calc(-100% - var(--o))); }
  .dg__call.is-below::after { transform: rotate(45deg); }
  .dg__call.is-below.is-flip::after { transform: scaleX(-1) rotate(45deg); }
  .dg__call.is-below .dg__call-t { transform: translate(var(--o), var(--o)); }
  .dg__call.is-below.is-flip .dg__call-t { transform: translate(calc(-100% - var(--o)), var(--o)); }

  /* CBCT: three slices, one row (8:5 each) */
  .dg__cbct { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--dg-edge); border-top: 1px solid var(--dg-edge); }
  html:not(.js) .dg__cbct { display: none; } /* the slices are drawn by script: no JS, no empty panes */
  .dg__pane { position: relative; aspect-ratio: 8 / 5; background: #0b0d10; }
  .dg__pane canvas { width: 100%; height: 100%; }
  .dg__pane-l { position: absolute; left: 8px; top: 6px; color: var(--stroke); font-size: 0.58rem; letter-spacing: 0.14em; pointer-events: none; }

  /* wizard: Step N/6 + name + progress */
  .dg__wiz { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(64px, 26%); align-items: center; gap: 16px; height: 46px; padding: 0 16px; border-top: 1px solid var(--dg-edge); }
  .dg__wiz-n { color: var(--stroke); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dg__wiz-t { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--fg); font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.01em; text-transform: none; }
  .dg__prog { position: relative; height: 2px; background: var(--dg-edge); }
  .dg__prog i { position: absolute; inset: 0; background: var(--stroke); transform-origin: 0 50%; transition: transform 0.6s var(--ease-out); }
  .dg__prog b { position: absolute; top: -2px; bottom: -2px; width: 2px; margin-left: -1px; background: var(--dg-win); } /* the five gaps between the six segments (plain rectangles: a hard-stop gradient here was one more GPU shader to compile on a cold cache) */

  /* ---------- steps ---------- */
  .dg__step { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: var(--dg-step-h); padding: 2rem 0 2rem clamp(20px, 2.6vw, 40px); }
  .dg__step::before { content: ''; position: absolute; left: 0; top: 18%; bottom: 18%; width: 1px; background: var(--stroke); transition: transform 0.7s var(--ease-out); }
  /* Everything is lit by default (no JS, static); only a live section (data-mode set by digital.js) dims the steps that are not current. */
  .dg[data-mode='live'] .dg__step:not(.is-on)::before { transform: scaleY(0); }
  .dg__no { font-weight: 300; font-size: clamp(3rem, 2rem + 3.4vw, 5rem); line-height: 1; color: var(--stroke); -webkit-text-stroke: 1px var(--stroke); transition: color 0.6s, -webkit-text-stroke-color 0.6s; }
  .dg[data-mode='live'] .dg__step:not(.is-on) .dg__no { color: transparent; -webkit-text-stroke-color: color-mix(in srgb, var(--stroke) 55%, transparent); }
  .dg__name { margin-top: 0.6rem; font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.6rem); line-height: 1.04; transition: opacity 0.6s var(--ease-out); }
  .dg[data-mode='live'] .dg__step:not(.is-on) .dg__name { opacity: 0.55; } /* 0.55 of paper on ink is still 5.3:1 */
  .dg__link { display: block; }
  .dg[data-mode='live'] .dg__step:not(.is-on):hover .dg__name { opacity: 0.85; }
  .dg__link::after { content: ''; position: absolute; inset: 0; } /* the whole block is the click target */
  .dg__link:focus-visible { outline: none; }
  .dg__link:focus-visible::after { outline: 3px solid var(--stroke); outline-offset: -3px; }
  .dg__line { margin-top: 0.9rem; max-width: 34ch; font-size: var(--step--1); line-height: 1.55; color: var(--muted); }
  @media (max-width: 999px), (pointer: coarse) {
    .dg__step { min-height: 34svh; }
    .dg__name { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2rem); }
    .dg__no { font-size: 2.4rem; }
  }
  @media (max-width: 599px) {
    .dg__tools { display: none; }
    .dg__main { grid-template-columns: minmax(0, 1fr); }
    .dg__title { display: none; }
    .dg__call-t { padding: 2px 5px; font-size: 0.62rem; letter-spacing: 0.08em; }
    .dg__tag { margin-left: auto; font-size: 0.56rem; }
